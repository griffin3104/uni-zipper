{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "uni-zipper",
  "version": "0.1.0",
  "identifier": "com.griffin.unizipper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "uni-zipper",
        "width": 480,
        "height": 400,
        "minWidth": 480,
        "minHeight": 400,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Japanese"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      },
      "wix": {
        "language": "ja-JP"
      }
    }
  }
}
